{
  "manifest_version": 3,
  "name": "Calm Capture",
  "version": "1.0.0",
  "description": "Active Inference knowledge resurfacing agent — capture any page with Cmd+Shift+K",
  "author": "Corteon",

  "permissions": [
    "activeTab",
    "nativeMessaging",
    "storage",
    "tabs",
    "scripting"
  ],

  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Calm Capture",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },

  "commands": {
    "capture": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Capture current page content"
    }
  },

  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "host_permissions": [
    "<all_urls>"
  ]
}
